# ============ IA (obligatoire) ============
# Clé API Anthropic — https://platform.claude.com
ANTHROPIC_API_KEY=sk-ant-...
# Modèles (laisser par défaut pour la meilleure qualité ; claude-haiku-4-5 pour réduire les coûts de qualification)
QUALIFY_MODEL=claude-opus-4-8
COMPOSE_MODEL=claude-opus-4-8

# ============ Sourcing (obligatoire) ============
# Google Places API (New) — console.cloud.google.com (activer "Places API (New)")
GOOGLE_PLACES_API_KEY=

# ============ Envoi email (obligatoire) ============
# Brevo (ex-Sendinblue) — gratuit jusqu'à 300 emails/jour — app.brevo.com > SMTP & API
BREVO_API_KEY=
SENDER_EMAIL=contact@cleantech-auto.fr
SENDER_NAME=Noah - CleanTech

# ============ Identité commerciale ============
COMPANY_NAME=CleanTech
COMPANY_WEBSITE=https://cleantech-auto.fr
SIGNATURE_PHONE=+33 6 00 00 00 00
PROMO_CODE=PRO10
# Mention légale ajoutée en pied de chaque email (opt-out RGPD B2B)
OPTOUT_TEXT=Vous recevez cet email car votre activité professionnelle est en lien avec nos produits. Répondez "STOP" pour ne plus être contacté.

# ============ Quotas & rythme (anti-spam / warm-up domaine) ============
# Commencer bas (20-25/jour) et monter progressivement sur 4 semaines
MAX_NEW_EMAILS_PER_DAY=20
MAX_FOLLOWUPS_PER_DAY=20
# Fenêtre d'envoi (heure de Paris), jours ouvrés uniquement
SEND_HOUR_START=9
SEND_HOUR_END=18
# Délai des relances (jours)
FOLLOWUP_1_DAYS=3
FOLLOWUP_2_DAYS=7
# Score IA minimum pour contacter un lead (0-100)
MIN_QUALIFY_SCORE=60
# Cycle de la boucle en minutes
CYCLE_MINUTES=15

# ============ Optionnel ============
# Hunter.io pour trouver des emails quand le site n'en affiche pas
HUNTER_API_KEY=
# Email du patron pour recevoir le rapport quotidien
DAILY_REPORT_EMAIL=
