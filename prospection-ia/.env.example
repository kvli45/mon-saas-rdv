# ⚠️ NE METS JAMAIS DE VRAIE CLÉ ICI — ce fichier est public (suivi par git).
# Copie-le vers .env (ignoré par git) et mets tes secrets DANS .env uniquement :
#   cp .env.example .env

# ============ IA (obligatoire) ============
ANTHROPIC_API_KEY=sk-ant-...
QUALIFY_MODEL=claude-opus-4-8
COMPOSE_MODEL=claude-opus-4-8

# ============ Envoi email — Gmail SMTP (premiers jours) ============
MAIL_PROVIDER=gmail
GMAIL_USER=ton.adresse@gmail.com
# Mot de passe d'application (PAS ton mot de passe Gmail — 16 lettres) :
# myaccount.google.com > Sécurité > Validation en 2 étapes (à activer) > Mots de passe des applications
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
SENDER_NAME=Noah - CleanTech
# Simulation : n'envoie AUCUN email réel (pour tester la pipeline). 1 = simulation.
DRY_RUN=1

# ============ Sourcing ============
# OPTIONNEL : Google Places (New). Si vide, le scraper trouve via recherche web (gratuit).
GOOGLE_PLACES_API_KEY=
# OPTIONNEL : Hunter.io — email pro quand le site n'en affiche pas
HUNTER_API_KEY=

# ============ Identité commerciale ============
COMPANY_NAME=CleanTech
COMPANY_WEBSITE=https://cleantech-auto.fr
SIGNATURE_PHONE=+33 6 00 00 00 00
PROMO_CODE=PRO10
OPTOUT_TEXT=Vous recevez cet email car votre activité professionnelle est en lien avec nos produits. Répondez "STOP" pour ne plus être contacté.

# ============ Dashboard ============
PORT=4300

# ============ Quotas & rythme (Gmail : rester bas, ~20-50/j au début) ============
MAX_NEW_EMAILS_PER_DAY=20
MAX_FOLLOWUPS_PER_DAY=20
SEND_HOUR_START=9
SEND_HOUR_END=18
FOLLOWUP_1_DAYS=3
FOLLOWUP_2_DAYS=7
MIN_QUALIFY_SCORE=60
CYCLE_MINUTES=15

# ============ Sourcing avancé ============
# Annuaire officiel des entreprises (recherche-entreprises.api.gouv.fr) — volume, gratuit
USE_REGISTRY=1
# Trouve le site web des leads qui n'en ont pas (nom + ville -> URL)
RESOLVE_WEBSITES=1
# En dernier recours, devine contact@domaine SI le domaine reçoit des emails (MX vérifié)
GUESS_EMAIL=1

# ============ Scraper (Playwright) ============
PW_CHROME_PATH=
PW_HEADFUL=0

# ============ Optionnel ============
DAILY_REPORT_EMAIL=
